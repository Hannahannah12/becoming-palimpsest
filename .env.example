OPENAI_API_KEY=replace_in_vercel_only
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=replace_in_vercel_only
DEEPSEEK_MODEL=deepseek-chat


# Optional shared quotas (both endpoints combined). Set in Vercel, never in HTML.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PREFIX=becoming-palimpsest
EXHIBITION_REQUESTS_PER_MINUTE=120
EXHIBITION_REQUESTS_PER_DAY=3000
# Set true for public exhibitions after configuring Redis; missing storage then fails closed.
REQUIRE_SHARED_RATE_LIMIT=false
